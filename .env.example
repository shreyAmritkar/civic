# PostgreSQL Docker Compose settings
POSTGRES_DB=civictrack
POSTGRES_USER=civictrack
POSTGRES_PASSWORD=civictrack
POSTGRES_PORT=5432

# Spring Boot connection settings (match the Compose values above)
DB_URL=jdbc:postgresql://localhost:5432/civictrack
DB_USERNAME=civictrack
DB_PASSWORD=civictrack
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
LLM_API_URL=http://localhost:11434/api/generate
LLM_MODEL=llama3.1:8b
# Leave blank for local Ollama. Only set this for a compatible remote gateway.
LLM_API_KEY=

# aws
S3_BUCKET =
S3_REGION =
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=